<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <!-- PublishAot puts the runtime pack in the dependency graph, where the SDK baseline resolves to
         an unpatched 10.0.x. Pin the patched one so security scanning sees what actually ships. -->
    <RuntimeFrameworkVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.11</RuntimeFrameworkVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DevTunnels.Client\DevTunnels.Client.csproj" />
    <ProjectReference Include="..\..\src\DevTunnels.Client.DependencyInjection\DevTunnels.Client.DependencyInjection.csproj" />
  </ItemGroup>
</Project>
